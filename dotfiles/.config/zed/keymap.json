[
  {
    "context": "!VimWaiting",
    "bindings": {
      // Pane navigation.
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "H": "vim::FirstNonWhitespace",
      "L": "vim::EndOfLine",
      "] t": "pane::ActivateNextItem",
      "[ t": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "Editor && vim_mode == insert", // && !menu
    "bindings": {
      "k j": ["workspace::SendKeystrokes", "cmd-s escape"],
    },
  },
  // {
  //   "context": "vim_mode == normal && !menu", // && !menu
  //   "bindings": {
  //     "*": ["workspace::SendKeystrokes", "v i w cmd-f"]
  //   }
  // },
  {
    "context": "Editor",
    "bindings": {
      "cmd-k enter": "project_panel::OpenPermanent",
      "cmd-g": "editor::SelectLargerSyntaxNode"
    }
  },
  {
    "bindings": {
      "cmd-shift-j": "multi_workspace::NextThread"
    }
  },
  {
    "bindings": {
      "cmd-shift-k": "multi_workspace::PreviousThread"
    }
  }
]
