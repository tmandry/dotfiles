// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "ssh_connections": [
    {
      "host": "100.80.48.127",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/tyler/code/accessibility"
          ]
        }
      ]
    },
    {
      "host": "air",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/tyler"
          ]
        },
        {
          "paths": [
            "/Users/tyler/code/accessibility"
          ]
        }
      ]
    }
  ],
  "git_panel": {
    "tree_view": false,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on"
      },
      "favorite_config_option_values": {
        "mode": [
          "https://agentclientprotocol.com/protocol/session-modes#autopilot",
          "https://agentclientprotocol.com/protocol/session-modes#plan",
        ],
      },
      "env": {
        "COPILOT_ALLOW_ALL": "true",
      },
      "type": "registry",
    },
  },
  "diff_view_style": "unified",
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "max_tabs": 8,
  "edit_predictions": {
    "mode": "subtle",
  },
  "show_edit_predictions": true,
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-opus-4-8",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "theme": { "dark": "Ayu Dark", "light": "One Light" },
  "buffer_font_family": "Iosevka",
  "ui_font_size": 12,
  "ui_font_weight": 600,
  "buffer_font_size": 11,
  "buffer_font_weight": 600, // 550
  "agent_buffer_font_size": 12,
  "agent_ui_font_size": 14,
  "buffer_font_features": { "ss04": true },
  "project_panel": {
    "dock": "right",
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "wrap_guides": [80, 100],
  "soft_wrap": "editor_width",
  //"seed_search_query_from_cursor": "selection",
  "double_click_in_multibuffer": "open",
  "terminal": {
    "dock": "bottom",
    "max_scroll_history_lines": 100000,
    "line_height": "standard",
    "font_family": "Iosevka Term",
    "font_size": 12,
    "font_weight": 550,
    "font_features": { "ss04": true },
  },
  "vim": {
    "use_system_clipboard": "never",
  },
  "tasks": {
    "variables": { "RUST_BACKTRACE": "1" },
  },
  "languages": {
    "Rust": {
      "inlay_hints": {
        // "enabled": true
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": { "features": "all" },
        "inlayHints": {
          "parameterHints": {
            "enable": false,
          },
          "typeHints": {
            "enable": true,
          },
        },
      },
    },
  },
  "git": {
    "inline_blame": {
      // Disable until https://github.com/zed-industries/zed/issues/24752
      // is fixed.
      "enabled": false,
      "delay_ms": 500,
    },
  },
  "profiles": {
    "max": {
      "settings": {
        "ui_font_size": 14,
        "buffer_font_size": 13,
        "minimap": {
          "display_in": "all_editors",
          "show": "always",
        },
      },
    },
  },
}
